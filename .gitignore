*.db

# Biometric material is referenced by path only, never copied (PRD 12, criterion 22)
ricardo-clone/

# OS and editor
.DS_Store
.idea/
.vscode/

# super-dev run state stays local (super-dev skill, references/state.md)
.engineos/super-dev/
