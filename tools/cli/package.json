{
  "name": "@studio/cli",
  "version": "0.1.0",
  "private": true,
  "description": "studio CLI (SPEC 0002 R1-21): Ink dashboard plus non-interactive commands; boots the core Nest command handlers in a standalone application context",
  "type": "module",
  "bin": {
    "studio": "dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod 755 dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/cqrs": "^11.0.0",
    "@node-rs/argon2": "^2.0.2",
    "@studio/core": "workspace:*",
    "@studio/shared": "workspace:*",
    "commander": "^14.0.0",
    "ink": "^6.0.0",
    "react": "^19.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@studio/eslint-config": "workspace:*",
    "@studio/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "eslint": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
