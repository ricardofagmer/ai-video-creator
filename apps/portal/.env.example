# EngineOS Video Creator portal (ADR 0010, plan rev 3 ticket 06). Read at build time and inlined
# into the static bundle: every value is public and none may ever hold a secret.

# Port of the local api the page calls at http://127.0.0.1:<port>. Default 4311 when unset.
NEXT_PUBLIC_ENGINEOS_VIDEO_CREATOR_API_PORT=4311
# Port of the local web opened by "Open studio" (http://127.0.0.1:<port>). Default 4310 when unset.
NEXT_PUBLIC_ENGINEOS_VIDEO_CREATOR_WEB_PORT=4310
# https URL of the release manifest latest.json (contract C2 rev 2). No default: unset shows
# "release address not configured". The host must answer with CORS for the portal origin.
NEXT_PUBLIC_ENGINEOS_VIDEO_CREATOR_RELEASE_MANIFEST_URL=
