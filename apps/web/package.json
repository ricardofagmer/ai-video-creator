{
  "name": "@studio/web",
  "version": "0.1.0",
  "private": true,
  "description": "Local Next.js web in pt-BR (SPEC 0002 R1-19, R1-20): catalog, recipes, runs and review; bound to 127.0.0.1 only (A9)",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p ${VIDEO_STUDIO_WEB_PORT:-4310}",
