    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@studio/shared": "workspace:*",
    "@studio/ui": "workspace:*",
    "next": "^15.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@studio/eslint-config": "workspace:*",
    "@studio/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.0.0",
    "typescript": "^5.8.3"
  }
}
