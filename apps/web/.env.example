# EngineOS Video Creator web (SPEC 0002 A9). These three values are optional; the defaults below apply when unset.
# The web listens on 127.0.0.1 only; these three names never hold a secret.

# Port of the web listener (dev and start scripts).
ENGINEOS_VIDEO_CREATOR_WEB_PORT=4310
# Origin the browser uses for the web; must match the api's ENGINEOS_VIDEO_CREATOR_WEB_ORIGIN.
ENGINEOS_VIDEO_CREATOR_WEB_ORIGIN=http://127.0.0.1:4310
# Origin of the local api (the studio CLI sets it); loopback only.
ENGINEOS_VIDEO_CREATOR_API_ORIGIN=http://127.0.0.1:4311

# Desktop installer portal (ADR 0010). Read by the api, not the web; listed here with the other
# origins. Must be an https:// origin with no path (for example https://portal.example.com); the
# api refuses to start otherwise. Unset means no cross-origin caller is accepted on /install/*.
# ENGINEOS_VIDEO_CREATOR_PORTAL_ORIGIN=

# Development only: skip the login page under `next dev` (docs/specs/2026-11-22-dev-auto-sign-in-design.md).
# Put real values in apps/web/.env.local (git-ignored), never in this file. Ignored by `next start`
# and production builds. Unset the switch (or set it to anything but 1) to turn it off.
ENGINEOS_VIDEO_CREATOR_DEV_AUTO_LOGIN=
# The passphrase you set with `studio passphrase set`.
ENGINEOS_VIDEO_CREATOR_DEV_PASSPHRASE=
