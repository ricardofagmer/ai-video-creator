# Video Studio web (SPEC 0002 A9). Both values are optional; the defaults below apply when unset.
# The web listens on 127.0.0.1 only; these names never hold a secret.

# Port of the web listener (dev and start scripts).
VIDEO_STUDIO_WEB_PORT=4310
# Origin the browser uses for the web; must match the api's VIDEO_STUDIO_WEB_ORIGIN.
VIDEO_STUDIO_WEB_ORIGIN=http://127.0.0.1:4310
# Origin of the local api (the studio CLI sets it); loopback only.
VIDEO_STUDIO_API_ORIGIN=http://127.0.0.1:4311
